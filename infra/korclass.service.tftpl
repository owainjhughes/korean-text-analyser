[Unit]
Description=Korean Difficulty Classifier
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Restart=always
RestartSec=10

ExecStartPre=/bin/bash -c 'install -m 600 /dev/null /run/korclass.env && echo "API_KEY=$(aws ssm get-parameter --name ${api_key_param} --with-decryption --region ${region} --query Parameter.Value --output text)" >> /run/korclass.env && echo "JAVA_TOOL_OPTIONS=-Xms64m -Xmx256m -XX:MaxMetaspaceSize=128m" >> /run/korclass.env'
ExecStartPre=-/usr/bin/docker rm -f korclass

ExecStart=/usr/bin/docker run --rm --name korclass --memory=700m --memory-swap=1500m --env-file /run/korclass.env --log-driver=awslogs --log-opt awslogs-region=${region} --log-opt awslogs-group=${log_group} --log-opt awslogs-create-group=false -p 127.0.0.1:8000:8000 ${ecr_url}:current

ExecStop=/usr/bin/docker stop korclass
ExecStopPost=/bin/rm -f /run/korclass.env

[Install]
WantedBy=multi-user.target
