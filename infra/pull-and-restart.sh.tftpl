#!/usr/bin/env bash
set -euo pipefail

TAG="$${1:-latest}"
REGION="${region}"
ECR="${ecr_url}"

echo "[deploy] logging in to ECR"
aws ecr get-login-password --region "$REGION" \
  | docker login --username AWS --password-stdin "$ECR"

echo "[deploy] pulling $ECR:$TAG"
docker pull "$ECR:$TAG"
docker tag "$ECR:$TAG" "$ECR:current"

echo "[deploy] restarting korclass service"
systemctl restart korclass.service

echo "[deploy] waiting for /health"
for i in $(seq 1 30); do
  if curl -fsS http://127.0.0.1:8000/health >/dev/null 2>&1; then
    echo "[deploy] healthy after $i seconds"
    exit 0
  fi
  sleep 1
done

echo "[deploy] health check failed; recent logs:"
journalctl -u korclass --no-pager -n 80 || true
exit 1
