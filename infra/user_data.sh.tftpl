#!/usr/bin/env bash
set -euxo pipefail

# ----- packages -----
dnf update -y
dnf install -y docker jq awscli-2

systemctl enable --now docker
usermod -aG docker ec2-user

# ----- swap (mitigates 1 GB RAM OOM on t3.micro) -----
if ! swapon --show | grep -q '/swapfile'; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
  sysctl vm.swappiness=10
fi

# ----- Caddy (static binary) -----
CADDY_VERSION=2.8.4
curl -fsSL "https://github.com/caddyserver/caddy/releases/download/v$${CADDY_VERSION}/caddy_$${CADDY_VERSION}_linux_amd64.tar.gz" -o /tmp/caddy.tgz
tar -xzf /tmp/caddy.tgz -C /tmp caddy
install -m 0755 /tmp/caddy /usr/local/bin/caddy
id caddy >/dev/null 2>&1 || useradd --system --home /var/lib/caddy --shell /sbin/nologin caddy
mkdir -p /etc/caddy /var/lib/caddy /var/log/caddy
chown -R caddy:caddy /var/lib/caddy /var/log/caddy

cat > /etc/caddy/Caddyfile <<'CADDYFILE_EOF'
${caddyfile_body}
CADDYFILE_EOF

cat > /etc/systemd/system/caddy.service <<'CADDY_SVC_EOF'
[Unit]
Description=Caddy reverse proxy
After=network-online.target
Wants=network-online.target

[Service]
User=caddy
Group=caddy
ExecStart=/usr/local/bin/caddy run --environ --config /etc/caddy/Caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/Caddyfile
TimeoutStopSec=5s
LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=full
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
CADDY_SVC_EOF

systemctl daemon-reload
systemctl enable --now caddy

# ----- App: deploy script + systemd unit -----
mkdir -p /opt/${project_name}

cat > /opt/${project_name}/pull-and-restart.sh <<'PULL_EOF'
${pull_and_restart_body}
PULL_EOF
chmod +x /opt/${project_name}/pull-and-restart.sh

cat > /etc/systemd/system/${project_name}.service <<'SVC_EOF'
${systemd_unit_body}
SVC_EOF
systemctl daemon-reload

# Enable for auto-start on reboot. Don't start here:
# the image hasn't been pushed yet on first apply, so first start happens
# when GitHub Actions calls pull-and-restart.sh via SSM after the first push.
systemctl enable ${project_name}.service

# Pre-warm ECR auth (best-effort; will be redone by pull-and-restart.sh on every deploy)
aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin ${ecr_url} || true

echo "user_data complete"
