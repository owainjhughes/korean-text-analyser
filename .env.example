
API_KEY=replace-me
JWT_SECRET=replace-with-a-long-random-string

# Auth cookie
JWT_TTL_DAYS=7
COOKIE_SECURE=false   # set to true in production (HTTPS)

# Database — async driver for the app, sync driver for Alembic.
# Local dev (docker-compose Postgres):
DATABASE_URL=postgresql+asyncpg://saebae:saebae@postgres:5432/saebae
DATABASE_URL_SYNC=postgresql+psycopg://saebae:saebae@postgres:5432/saebae
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL_SYNC=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
